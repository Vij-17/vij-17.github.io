---
interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<header class="wrap pt-14 pb-12 sm:pt-20">
  <h1 class="display gradient-text page-title">{title}</h1>
  {lead && <p class="mt-5 max-w-[38rem] text-[1.15rem] text-fg-muted">{lead}</p>}
  <slot />
</header>

<style>
  .page-title {
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.5rem);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
    font-weight: 350;
    padding-bottom: 0.08em;
    width: fit-content; /* lets the gradient span the word, not the whole row */
  }
</style>
