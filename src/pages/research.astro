---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import InterestDeck, { type Interest } from '../components/InterestDeck.tsx';

// Each interest is one card: a title, a short paragraph, and the paper or source that inspired it
// (clicking the card opens that link). Edit, reorder or add freely; the first one is on top of the stack.
const interests: Interest[] = [
  {
    id: 'in-vitro-in-vivo',
    title: 'Learning in vitro versus in vivo',
    body: 'Cultured cortical neurons adapt their activity when embedded in a closed sensory–motor loop, yet they learn more slowly and retain less than the same cells in an intact brain. I want to identify which properties of natural input (temporal correlation, multiscale spatial structure, behavioural contingency) are missing from artificial stimulation.',
    source: { label: 'Kagan et al., Neuron (2022)', href: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC9747182/' },
  },
  {
    id: 'integration',
    title: 'Plasticity and the integration of new neurons',
    body: 'Human cortical organoids transplanted into the somatosensory cortex of newborn rats matured further than the same organoids kept in a dish, received thalamic input, responded to whisker stimulation and could drive reward-seeking behaviour. I want to understand the plasticity that lets a host brain wire in foreign neurons, and what it provides that a dish does not.',
    source: { label: 'Revah et al., Nature (2022)', href: 'https://www.nature.com/articles/s41586-022-05277-w' },
  },
  {
    id: 'coordination',
    title: 'Coordination between brain regions',
    body: 'Hippocampal sharp-wave ripples coincide with the reactivation of recent experience in the neocortex, which is thought to consolidate memory. My honours thesis focused on detecting these events in primate recordings; the broader question is how two regions time their activity so precisely.',
    source: { label: 'Buzsáki, Hippocampus (2015)', href: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC4648295/' },
  },
  {
    id: 'emergence',
    title: 'Emergence and self-organisation',
    body: 'A single cell develops into an organism, and a regenerating tissue knows when to stop growing. Both depend on local interactions producing global order. I find the same question in neural circuits: how cognition emerges from cells that each follow simple rules.',
    source: { label: 'Wolfram, A New Kind of Science (2002)', href: 'https://www.wolframscience.com/nks/' },
  },
  {
    id: 'silicon',
    title: 'Living neurons and silicon',
    body: 'In the long term I want to work at the interface of biological neural systems and computing hardware, through neuromorphic engineering, neuroAI and biological computing with neuronal cultures and organoids.',
    source: {
      label: 'Smirnova et al., Frontiers in Science (2023)',
      href: 'https://www.frontiersin.org/journals/science/articles/10.3389/fsci.2023.1017235/full',
    },
  },
];
---

<Base title="Research" description="Research interests and the long-term question I want to pursue.">
  <PageHeader
    title="Research"
    lead="I want to answer basic questions about how neurons compute and learn before moving to disease-focused work."
  />

  <section class="wrap">
    <div class="glow glow-card question-box">
      <h2 class="display text-[clamp(1.5rem,1.1rem+1.5vw,2.25rem)] leading-tight">
        The question I want to pursue: why do neurons learn differently in a living brain than in a dish?
      </h2>
      <p class="mt-5 max-w-[40rem] text-fg-muted">
        Natural sensory input may carry temporal and spatial structure that artificial electrical stimulation lacks. If
        so, enriching the statistical structure of stimulation should move culture learning towards in vivo behaviour.
        This is a hypothesis; testing it is the plan for my MSc thesis and PhD.
      </p>
    </div>
  </section>

  <section class="wrap mt-20" aria-labelledby="interests">
    <h2 id="interests" class="section-title mb-10">Interests</h2>
    <InterestDeck client:visible items={interests} />
  </section>
</Base>

<style>
  .question-box {
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }
  .question-box:hover {
    transform: none;
  }
</style>
