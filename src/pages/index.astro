---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import NeuralBoard from '../components/NeuralBoard.tsx';
import RotatingWord from '../components/RotatingWord.tsx';
import Timeline from '../components/Timeline.astro';
import ProjectList from '../components/ProjectList.astro';
import PostList from '../components/PostList.astro';
import ReadingList from '../components/ReadingList.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';
import { getPosts, getProjects, getReading } from '../lib/content';

const projects = (await getProjects()).slice(0, 3);
const posts = site.showWriting ? (await getPosts()).slice(0, 3) : [];
const reading = site.showWriting ? (await getReading()).slice(0, 3) : [];
---

<Base>
  <!-- Hero: the board is a live cellular automaton; the text sits on the quiet left side. -->
  <section class="hero">
    <NeuralBoard client:visible />
    <div class="wrap hero-inner">
      <h1 class="display hero-name gradient-text">{site.name}</h1>
      <p class="hero-intro">{site.intro}</p>
      <p class="hero-thinking">
        Currently thinking about <RotatingWord client:load words={site.thinkingAbout} />
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={url('/research')} class="glow btn btn-primary">Read my research question</a>
        {
          site.cvPdf && (
            <a href={url(site.cvPdf)} class="glow btn" download>
              <Icon name="download" /> Download CV
            </a>
          )
        }
      </div>
    </div>
    <p class="wrap board-caption">
      Behind this text: a simulated sheet of excitable cells (Brian’s Brain), shown as in calcium imaging: each cell
      flashes when it fires and fades as it recovers. Move your cursor or tap to stimulate it.
    </p>
  </section>

  <section class="wrap mt-24 sm:mt-32" aria-labelledby="question">
    <div class="grid gap-10 lg:grid-cols-[1fr_20rem] lg:gap-16">
      <div>
        <h2 id="question" class="display question">
          Neurons in a dish can learn. Why do the same neurons learn faster, and keep what they learn, inside a living brain?
        </h2>
        <p class="measure mt-6 text-fg-muted">
          My working hypothesis is that natural sensory input carries temporal and spatial structure that artificial
          electrical stimulation does not reproduce. I want to test that idea across my MSc thesis and PhD, combining
          electrophysiology with computational models of plasticity.
        </p>
        <a href={url('/research')} class="text-link mt-5 inline-block">More on my research interests</a>
      </div>
      <aside class="self-start border-l border-line pl-6 text-[0.98rem]">
        <p class="text-fg-muted">Other interests</p>
        <ul class="mt-2 space-y-1.5">
          <li>Hippocampal–neocortical coordination during sleep and rest</li>
          <li>How transplanted neurons integrate into a host brain</li>
          <li>Emergence: how simple local rules build an organism</li>
          <li>Interfacing living neurons with silicon</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="wrap mt-24 sm:mt-32" aria-labelledby="path">
    <h2 id="path" class="section-title mb-10">Education</h2>
    <Timeline />
  </section>

  <section class="wrap mt-24 sm:mt-32" aria-labelledby="work">
    <div class="mb-8 flex items-baseline justify-between gap-4">
      <h2 id="work" class="section-title">Research experience and projects</h2>
      <a href={url('/projects')} class="text-link shrink-0 text-[0.95rem]">View all</a>
    </div>
    <ProjectList projects={projects} />
  </section>

  {
    site.showWriting && (
  <section class="wrap mt-24 sm:mt-32" aria-labelledby="writing">
    <div class="grid gap-16 lg:grid-cols-2">
      <div>
        <div class="mb-8 flex items-baseline justify-between gap-4">
          <h2 id="writing" class="section-title">Writing</h2>
          <a href={url('/writing')} class="text-link text-[0.95rem]">All posts</a>
        </div>
        <PostList posts={posts} />
      </div>
      <div>
        <div class="mb-8 flex items-baseline justify-between gap-4">
          <h2 class="section-title">Worth reading</h2>
          <a href={url('/writing#reading')} class="text-link text-[0.95rem]">Full list</a>
        </div>
        <ReadingList items={reading} showNotes={false} />
      </div>
    </div>
  </section>
    )
  }
</Base>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 52rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 4rem 2.5rem;
    overflow: hidden;
  }
  .hero :global(.neural-board) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.75;
    /* Keep the left side calm so the text stays readable */
    mask-image: linear-gradient(90deg, transparent 0%, transparent 25%, rgb(0 0 0 / 0.18) 45%, black 72%),
      linear-gradient(180deg, transparent 0%, black 12%, black 85%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }
  .hero-inner {
    position: relative;
    pointer-events: none;
  }
  .hero-inner a {
    pointer-events: auto;
  }
  .hero-name {
    font-size: clamp(3rem, 1.6rem + 6.5vw, 7rem);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
    font-weight: 350;
    line-height: 0.98;
    padding-bottom: 0.08em; /* stops descenders being clipped by background-clip */
    max-width: 12ch;
    width: fit-content;
  }
  .hero-intro {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.55;
  }
  .hero-thinking {
    margin-top: 1rem;
    color: var(--color-fg-muted);
    min-height: 1.7em;
  }
  .board-caption {
    position: relative;
    margin-top: auto;
    padding-top: 3rem;
    font-size: 0.85rem;
    color: rgb(163 163 163 / 0.75);
    text-align: right;
  }
  .board-caption {
    max-width: 68rem;
  }
  .question {
    font-size: clamp(1.7rem, 1.2rem + 1.9vw, 2.75rem);
    font-variation-settings: 'SOFT' 100, 'opsz' 72;
    line-height: 1.18;
    max-width: 22em;
  }

  @media (max-width: 640px) {
    .hero :global(.neural-board) {
      opacity: 0.45;
      mask-image: linear-gradient(180deg, transparent 0%, black 30%, black 85%, transparent 100%);
    }
    .board-caption {
      text-align: left;
    }
  }
</style>
