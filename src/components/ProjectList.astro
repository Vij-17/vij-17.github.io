---
import { url } from '../lib/url';
import type { CollectionEntry } from 'astro:content';
interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---

<!-- Each project is a cuicui-style glow card: the rim lights up as the pointer approaches. -->
<ul class="grid gap-4 md:grid-cols-2">
  {
    projects.map((p) => (
      <li>
        <a href={url(`/projects/${p.id}`)} class="glow glow-card group block h-full">
          <span class="flex h-full flex-col px-4 pb-3 pt-4 sm:px-5">
            <span class="text-[0.9rem] text-fg-muted">{p.data.period}</span>
            <span class="display mt-2 block text-[1.4rem] leading-snug">{p.data.title}</span>
            <span class="mt-2 block text-fg-muted">{p.data.summary}</span>
            {p.data.tools.length > 0 && (
              <span class="mt-auto flex flex-wrap gap-2 pt-5">
                {p.data.tools.map((t) => (
                  <span class="rounded-full bg-white/5 px-2.5 py-0.5 text-[0.85rem] text-fg-muted">{t}</span>
                ))}
              </span>
            )}
          </span>
        </a>
      </li>
    ))
  }
</ul>
