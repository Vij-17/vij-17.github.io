---
import Links from './Links.astro';
import { site } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="wrap mt-28 text-[0.95rem]">
  <div class="flex flex-col gap-6 border-t border-line py-10 sm:flex-row sm:items-center sm:justify-between">
    <Links />
    <p class="text-fg-muted">{site.name}, {site.location}, {year}</p>
  </div>
</footer>
