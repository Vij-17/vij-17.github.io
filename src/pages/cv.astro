---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';

// Mirrors the PDF CV. Keep these honest: they are read by people who may test them in an interview.
const skills = [
  {
    group: 'Electrophysiology analysis',
    items:
      'LFP preprocessing, digital filtering (band-pass, notch), spectral analysis, z-scoring and envelope-based event detection, event-locked analysis; Brainstorm; Plexon .pl2 wide-band data',
  },
  { group: 'Programming', items: 'MATLAB; Python (beginner); conda environment setup; AI-assisted coding in VS Code' },
  {
    group: 'Bioinformatics',
    items:
      'Sequence analysis (BLAST, ClustalW, Galaxy); NCBI, Ensembl and UCSC Genome Browser; pairwise alignment algorithms and hidden Markov models; NGS data-analysis workflows',
  },
  {
    group: 'Laboratory (BSc practical courses)',
    items:
      'Molecular biology, protein biochemistry, cell culture and microscopy, microbiology and immunology techniques; the full list is in the PDF',
  },
  {
    group: 'Training',
    items:
      'Bioinformatics Specialization, University of California San Diego (Coursera); Python, Biopython and NGS Data Analysis, CBIRT',
  },
];
const languages = 'English (fluent), Telugu (native), Hindi (fluent)';
---

<Base title="CV" description="Education, research experience and skills.">
  <PageHeader title="CV" lead="A short version. The PDF has full details.">
    {
      site.cvPdf && (
        <a href={url(site.cvPdf)} class="glow btn btn-primary mt-8" download>
          <Icon name="download" /> Download PDF
        </a>
      )
    }
  </PageHeader>

  <section class="wrap" aria-labelledby="education">
    <h2 id="education" class="section-title mb-10">Education and research</h2>
    <Timeline />
  </section>

  <section class="wrap mt-20" aria-labelledby="skills">
    <h2 id="skills" class="section-title mb-8">Skills</h2>
    <dl class="max-w-[44rem] divide-y divide-line border-y border-line">
      {
        skills.map((s) => (
          <div class="grid gap-1 py-4 sm:grid-cols-[13rem_1fr] sm:gap-6">
            <dt class="font-semibold">{s.group}</dt>
            <dd class="text-fg/90">{s.items}</dd>
          </div>
        ))
      }
      <div class="grid gap-1 py-4 sm:grid-cols-[13rem_1fr] sm:gap-6">
        <dt class="font-semibold">Languages</dt>
        <dd class="text-fg/90">{languages}</dd>
      </div>
    </dl>
  </section>
</Base>
